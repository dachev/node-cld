{
  "name": "cld-universal",
  "description": "Language detection for Javascript. Based on the CLD2 (Compact Language Detector) library from Google. Highly optimized for space and speed. Runs about 10x faster than other libraries. Detects over 160 languages. Full test coverage. Runs on Linux, OS X, and Windows, and in the browser via a WASM fallback when the native addon is unavailable.",
  "keywords": [
    "language",
    "detect",
    "language detection",
    "cld",
    "cld2",
    "wasm",
    "webassembly"
  ],
  "version": "2.11.1",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./wasm/browser-entry.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "wasm/dist",
    "wasm/browser-entry.js",
    "src",
    "deps/cld/public",
    "deps/cld/internal",
    "deps/cld/binding.gyp",
    "binding.gyp",
    "bin",
    "README.md"
  ],
  "dependencies": {
    "glob": "^12",
    "node-addon-api": "^2.0.0",
    "underscore": "^1.13.7"
  },
  "scripts": {
    "install": "node bin/build-native.js",
    "build": "node-gyp rebuild",
    "build:wasm": "scripts/build-wasm.sh",
    "test": "node test/runner.js && node test/runner-wasm.js && node test/runner-wasm-browser.js",
    "postinstall": "node bin/postinstall.js"
  },
  "author": {
    "name": "Blagovest Dachev",
    "email": "blago@dachev.com",
    "url": "http://www.dachev.com"
  },
  "contributors": [
    "Lovell Fuller <npm@lovell.info>",
    "Figulus Project <npm@figulus.net>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figulusproject/cld-universal.git"
  },
  "bugs": {
    "url": "https://github.com/figulusproject/cld-universal/issues"
  },
  "homepage": "https://github.com/figulusproject/cld-universal#readme",
  "licenses": [
    {
      "type": "Apache",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "engines": {
    "node": "20 || >=22"
  }
}
